---
import Icon from './Icon.astro';
import { base, route, type Locale } from '../data/content';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const cn = locale === 'cn';
const flows = cn ? [
 {id:'image', title:'图集 → 服务 App', name:'image-to-appcard-flow', intro:'一次设计一组相关页面，把视觉、数据和动作一起组织为真实的服务体验。', steps:[['测量来源','保留 prompt、图集、页面裁切与坐标变换。'],['映射语义','把文字、控件、数值图表与图片分别映射到组件。'],['连接服务','提取服务卡片，绑定 reducer、状态、授权与操作。'],['验证与发布','检查组件和实际画面，再输出原生或 WASM 包。']]},
 {id:'sketch',title:'Sketch → 组件 kit', name:'sketch-to-appcard', intro:'利用设计文档的层级、symbol 与 source ID，把完整设计系列转为可复用的原生组件。',steps:[['读取设计','解析画板、分组、字体、mask 和稳定的来源 ID。'],['原生组合','文字成为 Label，控件保留交互，图片保留来源。'],['检查与修复','用组件树、布局、真实输入与原生帧验证结果。'],['提升为 kit','抽取共享定义、token 和绑定，让新页面复用组件。']]},
] : [
 {id:'image',title:'Atlas → service app',name:'image-to-appcard-flow',intro:'Design related screens together, then connect their visuals, data and actions into a working service experience.',steps:[['Measure the source','Preserve the prompt, atlas, scene crops and coordinate transforms.'],['Map semantics','Map text, controls, numerical charts and artwork to appropriate components.'],['Bind the service','Extract service cards and connect reducers, state, grants and actions.'],['Verify and package','Inspect widgets and real frames, then export native or WASM packages.']]},
 {id:'sketch',title:'Sketch → component kit',name:'sketch-to-appcard',intro:'Use document hierarchy, symbols and source IDs to turn a design family into reusable native components.',steps:[['Read the design','Parse artboards, groups, fonts, masks and stable source IDs.'],['Compose natively','Keep text as labels, controls interactive and artwork traceable.'],['Inspect and repair','Verify trees, layout, real input and native frames.'],['Promote to a kit','Extract shared definitions, tokens and bindings for new pages.']]},
];
const mappings = [
 {id:'choose_time',type:'KitButton',event:'installation.open_slots',rect:[9.2,71.89,37.99,6.66],label:cn?'选择时间':'Choose a time',detail:cn?'来源按钮成为 KitButton，独立保留控件与文字；动作交给安装服务处理。':'The source button becomes a KitButton with separate control and label children; the installation service handles its action.'},
 {id:'text_14',type:'Label',event:'—',rect:[9.42,26.68,36.09,3.74],label:cn?'标题文字':'Title text',detail:cn?'“空调已送达”保持为可检查文字，字体、换行与矩形可以单独验证。':'“空调已送达” remains inspectable text; font, wrapping and bounds can be checked independently.'},
 {id:'product_photo',type:'Image',event:'—',rect:[8.99,43.3,30.17,14.3],label:cn?'产品照片':'Product photo',detail:cn?'图片只承载产品照片，记录原始裁切、hash、fit 和 clip，不烘焙标题或按钮。':'Only the product photo stays raster, with a recorded crop, hash, fit and clip. Titles and buttons remain widgets.'},
];
---
<section id="flows" class="story-band" aria-labelledby="flows-title"><div class="container">
  <div class="section-heading"><div><span class="eyebrow">07 / PIXELS → COMPONENTS → APP</span><h2 id="flows-title">{cn ? '让每一个像素，\n找到它的组件。' : 'Give the pixels\na component model.'}</h2></div><p>{cn ? '两条流程保留来源与运行时的对应关系，让 Agent 能从设计进入源码，再回到真实组件与交互中验证。' : 'Two flows preserve the link from visual source to runtime, letting an agent move into code and back to real widgets and interactions for verification.'}</p></div>
  <div class="flow-explorer" data-tabs>
    <div class="flow-tabs" role="tablist" aria-label={cn ? '设计到应用流程' : 'Design-to-app flows'}>{flows.map((flow,i)=><button type="button" role="tab" id={`flow-tab-${flow.id}`} aria-controls={`flow-panel-${flow.id}`} aria-selected={i===0?'true':'false'} tabindex={i===0?0:-1}><span>0{i+1}</span>{flow.title}<Icon name={i===0?'grid':'layers'} size={18}/></button>)}</div>
    {flows.map((flow,i)=><div id={`flow-panel-${flow.id}`} role="tabpanel" aria-labelledby={`flow-tab-${flow.id}`} hidden={i!==0}>
      <div class="flow-heading"><div><h3>{flow.name}</h3><p>{flow.intro}</p></div><a class="text-link" href={`https://github.com/OctoSense-org/Octoscript-AppCard/tree/main/lab/${flow.name}`}>GitHub<Icon name="diagonal" size={16}/></a></div>
      <ol class="flow-stages">{flow.steps.map(([title,body],j)=><li><span>0{j+1}</span><h4>{title}</h4><p>{body}</p></li>)}</ol>
      {flow.id==='image' ? <div class="mapping-example" data-mapping-explorer>
        <div class="mapping-copy"><span class="eyebrow">AIRCON / SCENE 05</span><h3>{cn?'例证：送达后的安装邀约':'Example: installation after delivery'}</h3><p>{cn?'点选一个来源元素，查看它在原生界面中的组件类型与服务事件。':'Select a source element to inspect its native component type and service event.'}</p>
          <div class="mapping-buttons">{mappings.map((m,j)=><button type="button" aria-pressed={j===0?'true':'false'} data-mapping-id={m.id} data-type={m.type} data-event={m.event} data-rect={m.rect.join(',')} data-detail={m.detail}><span>{m.label}</span><code>{m.type}</code></button>)}</div>
          <div class="mapping-inspector" aria-live="polite" aria-atomic="true"><dl><dt>SOURCE ID</dt><dd data-inspector-id>{mappings[0].id}</dd><dt>WIDGET</dt><dd data-inspector-type>{mappings[0].type}</dd><dt>EVENT</dt><dd data-inspector-event>{mappings[0].event}</dd></dl><p data-inspector-detail>{mappings[0].detail}</p></div>
        </div>
        <div class="mapping-images"><figure><figcaption>{cn?'01 / 设计参考':'01 / DESIGN REFERENCE'}</figcaption><img src={`${base}/examples/aircon-installation-reference.png`} alt={cn?'空调安装邀约的原始设计参考，包含文字、产品照片和选择时间按钮':'Original air-conditioner installation design with text, product photo and a choose-time button'} loading="lazy" width="812" height="1552"/></figure><figure><figcaption>{cn?'02 / 原生组件渲染':'02 / NATIVE WIDGET RENDER'}</figcaption><div class="mapped-render"><img src={`${base}/examples/aircon-installation-native.png`} alt={cn?'同一安装邀约的实际 Makepad 原生渲染，文字与按钮是独立组件':'Actual Makepad native render of the same installation card, with separate text and button widgets'} loading="lazy" width="812" height="1552"/><span class="mapping-outline" data-mapping-outline aria-hidden="true" style="left:9.2%;top:71.89%;width:37.99%;height:6.66%"></span></div></figure></div>
        <p class="mapping-caption">{cn?'归档原生渲染与源图对照；高亮按来源映射区域定位。这一轮仍有字体、图标和阴影差异，展示的是可检查、可修正的组件映射。':'Archived source and native render; highlights locate mapped source regions. This iteration retains typography, icon and shadow differences, showing inspectable, repairable component mapping.'}</p>
      </div> : <div class="sketch-example"><div><span class="eyebrow">TASKPLAN / ATRO / CAMO</span><h3>{cn?'从设计系列中，提取可组合的语言。':'Extract a reusable vocabulary from a design family.'}</h3><p>{cn?'Camo 音乐行保留封面 Image、标题 Label 和播放控件，再提升为共享的 CamoTrackRow。页面用实例参数提供内容与状态，原 source ID 仍可追溯。':'A Camo music row retains its cover Image, title Label and play control, then becomes a shared CamoTrackRow. Instance parameters supply content and state while preserving source IDs.'}</p><p>{cn?'初次导入保留固定画板；响应式布局与真实业务行为仍由应用补齐。定量图表使用数值组件与明确数据，不能退化成一张曲线图片。':'The initial import preserves a fixed artboard; responsive layout and application behavior still need authoring. Quantitative charts use numerical widgets and explicit data, rather than painted curves.'}</p></div><div class="kit-tree"><span class="eyebrow">{cn?'组件结构示意':'COMPONENT STRUCTURE'}</span><pre tabindex="0"><code>{`CamoTrackRow\n├─ Image       cover\n├─ Label       title\n├─ Label       artist\n└─ control     play\n\nKitButton  ·  KitFormField\nKitTabBar  ·  TaskplanProjectCard`}</code></pre><span class="kit-result">{cn?'一个定义 → 多个实例 → 新页面':'ONE DEFINITION → MANY INSTANCES → NEW PAGES'}</span></div></div>}
    </div>)}
  </div>
  <div class="flow-links"><a class="text-link" href={route(locale,'docs/design-to-app/')}>{cn?'阅读两条完整流程与映射规则':'Read both flows and their mapping rules'}<Icon name="arrow" size={16}/></a><a class="text-link" href={`https://octosense.org/${cn?'cn/':''}experience/aircon/`}>{cn?'体验空调服务流程':'Try the aircon service flow'}<Icon name="diagonal" size={16}/></a></div>
</div></section>

---
import Layout from '../layouts/Layout.astro';
import { route } from '../data/content';
---
<Layout locale="en" title="Page not found — Octoscript" noindex>
  <main id="main" class="container not-found"><span class="eyebrow">404 / A SMALL DETOUR</span><h1>Let's find the next step</h1><p>This page isn't here. Start again from the homepage.</p><a class="button button-primary" href={route('en')}>Back to Octoscript →</a><a class="text-link" href={route('cn')} lang="zh-CN">返回中文首页 →</a></main>
</Layout>
